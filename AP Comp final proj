// Update Tables' Status

function updateTable (){
  var text = "";
  for (var i = 0; i < tables.length; i++){
    text = text + "\n" + tables[i] + ":" + "\n" + checkstatus(tables[i]);
  }
  setProperty("Orders","text", text);
}

// In certain intervals the tables will be randomly taken by a customer

function AutoAdd(){
  playSound("sound://category_achievements/melodic_win_4.mp3", false);
  setInterval(addTable, 3000);
  setInterval(updateTable, 3000);
  updateTable();
}

