// Checks if the user chooses the correct answer and sends them back to the homepage

function isOrderCorrect(order, number){
  for (var orderIndex = 0; orderIndex < order.length; orderIndex++){
    var Food = order[orderIndex];
    var inputID = number + "amount" + Food;
    var input = getText(inputID);
    if (input == ""){
      input = 0;
    }
    
    input = Number(input);
    if (input < 1){
      return false;
    }
  }
  
  for (var foodIndex = 0; foodIndex < food.length; foodIndex++){
    var foodItem = food[foodIndex];
    var inputID2 = number + "amount" + foodItem;
    var input2 = getText(inputID2);
    if (input2 == ""){
      input2 = 0;
    }
    input2 = Number(input2);
    var found = false;
    for (var orderIndex2 = 0; orderIndex2 < order.length; orderIndex2++){
        if (foodItem == order[orderIndex2]){
          found = true;
          break;
        }
      }
      if (!found && input2 > 0){
        return false;
      }
    }
  return true;
}

function correctOrder(number){
  var index = findTableindex("Table" + number);
  
  var tableorder = tableorders[index];
  
  var enough = true;
  

  if (isOrderCorrect(tableorder, number) == true && isAmountCorrect(number, tableorder) == true && enough == true) {
    changeFoodAmount(tableorder);
  
    money = money + totalPrice(tableorder);
    setProperty("restStatus","text", "You have $" + money);
    setProperty("table" + number, "border-color","transparent");

    removeItem(filteredtables, index);
    removeItem(tableorders,index);
    removeItem(tableTimers,index);
    setScreen("Homescreen");
    updateTable();
    playSound("sound://category_bell/vibrant_game_correct_answer_1.mp3", false);

  } else if (!enough) {
  setProperty("customer_Order" + number,"text", "\nYou do not have \nenough ingredients");
  setProperty("backOrder" + number, "background-color","red");
  playSound("sound://category_digital/failure.mp3",false); 
  playSound("sound://category_digital/failure.mp3",false); 
  } else {
    setProperty("customer_Order" + number,"text", "\nThat is not the correct order");
    setProperty("backOrder" + number, "background-color","red");
    playSound("sound://category_digital/failure.mp3",false);
    playSound("sound://category_digital/failure.mp3",false);
  }
}

function isAmountCorrect (number,order){
  for (var i = 0; i < food.length; i++) {
    
    var count = 0;
    for (var k = 0; k < order.length; k++){
      if (order[k] == food[i]){
        count++;
      }
    }
    
    var input = getText(number + "amount" + food[i]);
    input = Number(input);
    
    if (input == ""){
      input = 0;
    }
    
    if (input != count){
      return false;
    }
    
  }
  return true;
}

