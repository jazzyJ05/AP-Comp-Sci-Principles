// randomize the table that is added
// determine the status of the table on whether it is taken or not

function checkstatus (table){
  if (isTaken(table)) {
    return "TAKEN";
  } else {
    return "";
  }
}

function isTaken(table){
  for (var i = 0; i < filteredtables.length; i++){
    if (filteredtables[i] == table){
      return true;
    }
  }
  return false;
}

function isServed(table){
  for (var i = 0; i < tablesServed.length; i++){
    if (tablesServed[i] == table){
      return true;
    }
  }
  return false;
}

// Finds different index of the lists

function findTableindex (table){
  for (var i = 0; i < filteredtables.length; i++){
    if (filteredtables[i] == table){
      return i;
    }
  }
  return -1;
}

function findFoodindex (foodinsert){
  for (var i = 0; i < food.length; i++){
    if (food[i] == foodinsert){
      return i;
    }
  }
  return -1;
} 

// Customer will choose a random food for their order that is recorded 

function randomFood(){
  var orders = [];
  var numItems = randomNumber(1,5);
  

  for (var i = 0; i < numItems; i++){
    appendItem(orders, food[randomNumber(0, food.length-1)]);
  }
  
  return orders;
}

function keepOrder(number){
  var index = findTableindex("Table" + number);

  if (index != -1 && tableorders[index] != undefined) {
    var foodorder = tableorders[index];
    var totalprice = totalPrice(foodorder);

    setScreen("Order" + number);
    setProperty("customer_Order" + number,"text", findAmount(foodorder) + "\nTotal: $" + totalprice);
  } else {
    setProperty("table" + number,"text","Table " + number + " is currently empty");
  }
}

function findAmount (orders){
  var text = "";
  
  for (var j = 0; j < food.length; j++){
    var count = 0;
    for (var k = 0; k < orders.length; k++){
      if (orders[k] == food[j]){
        count ++;
      }
    }
    
    
    
    if (count > 0){
      text = text + food[j] + ": " + count + "\n";
    }
  }
  return text;
}

function ClickTable(next, number){
  onEvent("table" + next,"click", function(){

    var index = findTableindex("Table" + number);

    if (index != -1) {
      tableTimers[index] = -1; 
    }

    keepOrder(number);
  });
}

