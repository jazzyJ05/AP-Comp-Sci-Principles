  var tablenum = newcustomer.toLowerCase();
  
  if (isTaken(newcustomer) == false){
    appendItem(filteredtables, newcustomer);
    appendItem (tableorders, randomFood()); 
    appendItem (tableTimers, getTime());
    
    setProperty(tablenum, "border-color", "red");
    }
  
  return newcustomer;
