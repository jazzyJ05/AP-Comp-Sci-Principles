function totalPrice(tableorder){
  var item;
  var index;
  var price;
  var total = 0;
  for (var i = 0; i < tableorder.length; i++){
    item =  tableorder[i]; 
    index = findFoodindex(item);
    price = foodprices[index];
    total = Math.round(total + price);
  }
  return total;
}

function changeFoodAmount (tableorder){
  var enough = true;
  for (var j = 0; j < food.length; j++){
    var count = 0;
    for (var k = 0; k < tableorder.length; k++){
      if (tableorder[k] == food[j]){
        count++;
      }
    }
    if (count > foodamount[j]){
      enough = false;
    }
  }
  
  if(!enough){
    return false;
  }

  
   for (var i = 0; i < food.length; i++){
    var counti = 0;
    for (var k = 0; k < tableorder.length; k++){
      if (tableorder[k] == food[i]){
        counti++;
        }
      }
      
    foodamount[i] = foodamount[i] - counti;
    }
  return true;
}

function buyFood(){
  var selected = getText("foodDropdown");
  var index = findFoodindex(selected);
  var price = foodprices[index];
  console.log(price);
  if (getText("foodDropdown") == food[index] && money >= price){
      foodamount[index] = foodamount[index] + 4;
      money = Math.round(money - price);
      setProperty("restStatus","text", "You have $" + money);
      playSound("sound://category_alerts/vibrant_game_shutter_alert_1_short_quick.mp3", false);
    } else {
      setProperty("restStatus","text", "Not Enough Money");
      playSound("sound://category_alerts/playful_game_error_sound_4.mp3",false);
    }
}

